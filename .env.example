# ==========================================
# Telegram Bot Configuration
# ==========================================
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
# Comma-separated list of Admin Telegram IDs
ADMIN_IDS=123456789,987654321

# ==========================================
# Database Configuration (MySQL + aiomysql)
# ==========================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=deye_user
MYSQL_PASSWORD=deye_secret_password
MYSQL_DATABASE=deye_monitor
MYSQL_ROOT_PASSWORD=root_secret_password

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================================
# Deye Cloud OpenAPI (Master Account)
# ==========================================
DEYE_BASE_URL=https://eu1-developer.deyecloud.com
DEYE_APP_ID=your_deye_app_id
DEYE_APP_SECRET=your_deye_app_secret
DEYE_EMAIL=master_account@example.com
DEYE_PASSWORD=your_deye_password
# Set DEYE_MOCK_MODE=true for testing/demo without real Deye Cloud credentials
DEYE_MOCK_MODE=true

# ==========================================
# Monitoring & Thresholds
# ==========================================
POLL_INTERVAL_SECONDS=300
ELEVATOR_CRITICAL_SOC=20.0
VOLTAGE_MIN=207.0
VOLTAGE_MAX=253.0
TIMEZONE=Europe/Kyiv
